<html>

<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cadastro Aluno</title>
<style>
body {
font-family: Arial, sans-serif;
background-color: #f0f2f5;
display: flex;
justify-content: center;
align-items: center;
height: 100vh;
margin: 0;
}

.container {
background-color: #3b5998; /* Tom de azul da imagem */
width: 600px; /* Tamanho maior */
padding-bottom: 30px;
border-radius: 8px;
box-shadow: 0 4px 15px rgba(0,0,0,0.2);
overflow: hidden;
text-align: center;
}

.header {
background-color: #1a3a6d;
color: white;
padding: 20px;
font-size: 28px;
font-weight: bold;
letter-spacing: 2px;
margin-bottom: 40px;
}

.form-group {
margin: 25px 50px;
text-align: left;
}

label {
color: white;
font-weight: bold;
font-size: 22px;
display: inline-block;
width: 100px;
}

input {
background: transparent;
border: none;
border-bottom: 2px solid white;
color: white;
width: calc(100% - 110px);
font-size: 20px;
outline: none;
padding: 5px;
}

.btn-criar {
background-color: #0d2a54;
color: white;
border: none;
padding: 15px 60px;
border-radius: 30px;
font-size: 22px;
font-weight: bold;
cursor: pointer;
margin-top: 30px;
transition: background 0.3s;
}

.btn-criar:hover {
background-color: #081a35;
}
</style>
</head>
<body>

<div class="container">
<div class="header">CADASTRO ADMINISTRADOR</div>
<form>
<div class="form-group">
<label>GMAIL:</label>
<input type="email" name="gmail">
</div>

<div class="form-group">
<label>SENHA:</label>
<input type="password" name="senha">
</div>

<div class="form-group">
<label>CIDADE:</label>
<input type="text" name="nome">
</div>

<div class="form-group">
<label>ESCOLA:</label>
<input type="text" name="turma">
</div>

<button type="submit" class="btn-criar">CRIAR</button>
</form>
</div>

</body>
</html>

</html>
